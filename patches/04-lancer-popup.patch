+// ---------- Pop-up a l'ouverture du boitier ----------
+// Etat du couvercle partage entre toutes les taches (0 = inconnu, 1 = ouvert, 2 = ferme).
+// Le boitier change d'adresse Bluetooth regulierement, donc plusieurs taches l'ecoutent :
+// l'etat doit etre commun pour ne pas lancer deux pop-ups.
+static ETAT_COUVERCLE: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+// Le programme de la pop-up en cours (s'il y en a un).
+static POPUP: std::sync::Mutex<Option<std::process::Child>> = std::sync::Mutex::new(None);
+
+fn chemin_popup() -> std::path::PathBuf {
+    // Modifiable avec la variable d'environnement LIBREPODS_POPUP
+    if let Ok(p) = std::env::var("LIBREPODS_POPUP") {
+        return std::path::PathBuf::from(p);
+    }
+    let home = std::env::var("HOME").unwrap_or_default();
+    std::path::PathBuf::from(home)
+        .join(".local/share/airpods_popup/airpods-flipbook/target/release/airpods-flipbook")
+}
+
+fn ouvrir_popup() {
+    let mut guard = match POPUP.lock() { Ok(g) => g, Err(e) => e.into_inner() };
+    // Deja ouverte et toujours vivante ? On ne fait rien.
+    if let Some(child) = guard.as_mut() {
+        if let Ok(None) = child.try_wait() {
+            return;
+        }
+    }
+    let chemin = chemin_popup();
+    match std::process::Command::new(&chemin)
+        .env("POPUP_BOUCLE", "1")
+        // Mode X11 (XWayland) : seul moyen sous GNOME de rester au premier plan
+        .env_remove("WAYLAND_DISPLAY")
+        .spawn()
+    {
+        Ok(child) => {
+            info!("[POPUP] Pop-up lancee (pid {})", child.id());
+            *guard = Some(child);
+        }
+        Err(e) => log::warn!("[POPUP] Impossible de lancer {} : {}", chemin.display(), e),
+    }
+}
+
+fn fermer_popup() {
+    let mut guard = match POPUP.lock() { Ok(g) => g, Err(e) => e.into_inner() };
+    if let Some(mut child) = guard.take() {
+        let _ = child.kill();
+        let _ = child.wait(); // evite un processus "zombie"
+        info!("[POPUP] Pop-up fermee");
+    }
+}
