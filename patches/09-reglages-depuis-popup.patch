+/// La pop-up demande un changement de mode d'écoute en écrivant "ecoute=N" dans commande.txt.
+/// On lit le fichier, on le supprime (pour ne pas exécuter deux fois l'ordre) et on renvoie N.
+pub fn lire_commande_popup() -> Option<u8> {
+    let fichier = dossier_popup().join("commande.txt");
+    let contenu = std::fs::read_to_string(&fichier).ok()?;
+    let _ = std::fs::remove_file(&fichier);
+    contenu
+        .lines()
+        .find_map(|l| l.strip_prefix("ecoute="))
+        .and_then(|v| v.trim().parse::<u8>().ok())
+        .filter(|v| matches!(v, 1..=4)) // on n'accepte que les 4 modes connus
+}
+
