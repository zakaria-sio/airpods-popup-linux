Patch LibrePods : 02-batterie-boitier

Batterie du boîtier : garde la dernière bonne valeur au lieu d'afficher 0 %.

S'applique sur LibrePods, branche linux/rust, commit 672e65a.

diff --git a/linux-rust/src/bluetooth/aacp.rs b/linux-rust/src/bluetooth/aacp.rs
index b0ae420..d12a73d 100644
--- a/linux-rust/src/bluetooth/aacp.rs
+++ b/linux-rust/src/bluetooth/aacp.rs
@@ -543,6 +543,8 @@ impl AACPManager {
                             0x01 => BatteryStatus::Charging,
                             0x02 => BatteryStatus::NotCharging,
                             0x04 => BatteryStatus::Disconnected,
+                            // 0x05 = charge (bit 0x01) + dans le boitier : on le traite comme "en charge"
+                            x if x & 0x01 != 0 => BatteryStatus::Charging,
                             _ => {
                                 error!("Unknown battery status: {:#04x}", payload[base_index + 3]);
                                 continue;
@@ -551,6 +553,20 @@ impl AACPManager {
                     });
                 }
                 let mut state = self.state.lock().await;
+                // Les AirPods n'envoient la batterie du boitier que si un ecouteur est dedans.
+                // Sinon ils envoient "0% / Disconnected" (ou 255). On garde alors la derniere valeur connue.
+                for comp in [BatteryComponent::Left, BatteryComponent::Right, BatteryComponent::Case] {
+                    let is_valid = |b: &BatteryInfo| {
+                        b.component == comp && b.status != BatteryStatus::Disconnected && b.level <= 100
+                    };
+                    if batteries.iter().any(|b| is_valid(b)) {
+                        continue;
+                    }
+                    if let Some(prev) = state.battery_info.iter().find(|b| is_valid(b)).cloned() {
+                        batteries.retain(|b| b.component != comp);
+                        batteries.push(BatteryInfo { status: BatteryStatus::NotCharging, ..prev });
+                    }
+                }
                 state.battery_info = batteries.clone();
                 if let Some(ref tx) = state.event_tx {
                     let _ = tx.send(AACPEvent::BatteryInfo(batteries));
diff --git a/linux-rust/src/ui/window.rs b/linux-rust/src/ui/window.rs
index 4574b97..0f2de91 100644
--- a/linux-rust/src/ui/window.rs
