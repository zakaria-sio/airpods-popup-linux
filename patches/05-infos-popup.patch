+// Ecrit l'etat des AirPods dans un petit fichier texte que la pop-up relit en continu.
+// Format : une ligne "cle=valeur" par info, -1 = inconnu.
+// Ecriture "atomique" : on ecrit un fichier temporaire puis on le renomme,
+// pour que la pop-up ne lise jamais un fichier a moitie ecrit.
+fn ecrire_etat_popup(nom: &str, gauche: i32, gauche_charge: bool, droite: i32, droite_charge: bool,
+                     boitier: i32, boitier_charge: bool, gauche_oreille: bool, droite_oreille: bool) {
+    let home = std::env::var("HOME").unwrap_or_default();
+    let dossier = std::path::PathBuf::from(home).join(".local/share/airpods_popup");
+    if std::fs::create_dir_all(&dossier).is_err() {
+        return;
+    }
+    let b = |x: bool| if x { 1 } else { 0 };
+    let contenu = format!(
+        "nom={}\ngauche={}\ngauche_charge={}\ndroite={}\ndroite_charge={}\nboitier={}\nboitier_charge={}\ngauche_oreille={}\ndroite_oreille={}\n",
+        nom.replace('\n', " "), gauche, b(gauche_charge), droite, b(droite_charge),
+        boitier, b(boitier_charge), b(gauche_oreille), b(droite_oreille)
+    );
+    let tmp = dossier.join("etat.txt.tmp");
+    if std::fs::write(&tmp, contenu).is_ok() {
+        let _ = std::fs::rename(&tmp, dossier.join("etat.txt"));
+    }
+}
