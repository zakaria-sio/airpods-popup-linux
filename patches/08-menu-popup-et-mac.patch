Patch LibrePods : 08-menu-popup-et-mac

Entrée "Afficher la pop-up" dans le menu de l'icône + adresse Bluetooth pour le bouton Connecter.

S'applique sur LibrePods, branche linux/rust, commit 672e65a.

diff --git a/linux-rust/src/bluetooth/le.rs b/linux-rust/src/bluetooth/le.rs
index b2dec2b..43489cc 100644
--- a/linux-rust/src/bluetooth/le.rs
+++ b/linux-rust/src/bluetooth/le.rs
@@ -331,7 +331,10 @@ pub async fn start_le_monitor(tray_handle: Option<ksni::Handle<MyTray>>) -> blue
                                         // (0xff = inconnue), pour ne pas effacer une bonne valeur.
                                         {
                                             let b = |x: bool| if x { "1".to_string() } else { "0".to_string() };
-                                            let mut champs: Vec<(&str, String)> = vec![("nom", nom_popup.clone())];
+                                            let mut champs: Vec<(&str, String)> = vec![
+                                                ("nom", nom_popup.clone()),
+                                                ("mac", matched_airpods_mac.clone().unwrap_or_default()),
+                                            ];
                                             if left_byte != 0xff {
                                                 champs.push(("gauche", left_battery.to_string()));
                                                 champs.push(("gauche_charge", b(left_charging)));
