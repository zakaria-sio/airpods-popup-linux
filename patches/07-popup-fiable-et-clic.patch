+// ======================= Pop-up AirPods =======================
+// Le programme de la pop-up en cours (s'il y en a un).
+static POPUP: std::sync::Mutex<Option<std::process::Child>> = std::sync::Mutex::new(None);
+
+fn dossier_popup() -> PathBuf {
+    let home = std::env::var("HOME").unwrap_or_default();
+    PathBuf::from(home).join(".local/share/airpods_popup")
+}
+
+fn chemin_popup() -> PathBuf {
+    // Modifiable avec la variable d'environnement LIBREPODS_POPUP
+    if let Ok(p) = std::env::var("LIBREPODS_POPUP") {
+        return PathBuf::from(p);
+    }
+    dossier_popup().join("airpods-flipbook/target/release/airpods-flipbook")
+}
+
+/// Lance la pop-up. `manuel` = ouverte par un clic sur l'icone (elle se ferme seule apres quelques secondes).
+pub fn ouvrir_popup(manuel: bool) {
+    let mut guard = match POPUP.lock() { Ok(g) => g, Err(e) => e.into_inner() };
+    if let Some(child) = guard.as_mut() {
+        if let Ok(None) = child.try_wait() {
+            return; // deja ouverte
+        }
+    }
+    let chemin = chemin_popup();
+    let mut cmd = std::process::Command::new(&chemin);
+    cmd.env("POPUP_BOUCLE", "1")
+        // Mode X11 (XWayland) : seul moyen sous GNOME de rester au premier plan
+        .env_remove("WAYLAND_DISPLAY");
+    if manuel {
+        cmd.env("POPUP_MANUEL", "1");
+    }
+    match cmd.spawn() {
+        Ok(child) => {
+            log::info!("[POPUP] Pop-up lancee (pid {}{})", child.id(), if manuel { ", ouverte au clic" } else { "" });
+            *guard = Some(child);
+        }
+        Err(e) => log::warn!("[POPUP] Impossible de lancer {} : {}", chemin.display(), e),
+    }
+}
+
+pub fn fermer_popup() {
+    let mut guard = match POPUP.lock() { Ok(g) => g, Err(e) => e.into_inner() };
+    if let Some(mut child) = guard.take() {
+        let _ = child.kill();
+        let _ = child.wait(); // evite un processus "zombie"
+        log::info!("[POPUP] Pop-up fermee");
+    }
+}
+
+/// Met a jour certaines lignes "cle=valeur" du fichier d'etat lu par la pop-up,
+/// en gardant les autres. Plusieurs parties de LibrePods y ecrivent (signal du boitier,
+/// connexion directe), donc on fusionne au lieu d'ecraser.
+pub fn maj_etat_popup(champs: &[(&str, String)]) {
+    static VERROU: std::sync::Mutex<()> = std::sync::Mutex::new(());
+    let _v = match VERROU.lock() { Ok(g) => g, Err(e) => e.into_inner() };
+    let dossier = dossier_popup();
+    if std::fs::create_dir_all(&dossier).is_err() {
+        return;
+    }
+    let fichier = dossier.join("etat.txt");
+    let mut lignes: Vec<(String, String)> = std::fs::read_to_string(&fichier)
+        .unwrap_or_default()
+        .lines()
+        .filter_map(|l| l.split_once('=').map(|(k, v)| (k.to_string(), v.to_string())))
+        .collect();
+    for (cle, valeur) in champs {
+        let valeur = valeur.replace('\n', " ");
+        match lignes.iter_mut().find(|(k, _)| k == cle) {
+            Some(l) => l.1 = valeur,
+            None => lignes.push((cle.to_string(), valeur)),
+        }
+    }
+    let contenu: String = lignes.iter().map(|(k, v)| format!("{}={}\n", k, v)).collect();
+    // Ecriture "atomique" : fichier temporaire puis renommage
+    let tmp = dossier.join("etat.txt.tmp");
+    if std::fs::write(&tmp, contenu).is_ok() {
+        let _ = std::fs::rename(&tmp, &fichier);
+    }
+}
